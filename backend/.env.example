APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_PATH=models/cassava_effnet.h5
CONFIDENCE_THRESHOLD=0.30
MODEL_WEIGHT=0.50
