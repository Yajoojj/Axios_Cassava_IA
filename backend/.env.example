APP_ENV=development
# Origens do app (PWA). Em produção, troque pelo domínio publicado.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
MAX_UPLOAD_MB=8
ANALYSIS_MAX_SIDE=768
# Espelhamento horizontal na inferência (média de 2 passadas). Vazio = o que o modelo usou na avaliação.
TTA=

MODEL_PATH=models/greenleaf_effb0.onnx
MODEL_META_PATH=models/greenleaf_effb0.json
# Deixe vazios para usar os valores calibrados que estão em models/greenleaf_effb0.json
CONFIDENCE_THRESHOLD=
MODEL_WEIGHT=
MIN_INFECTION_RATIO=0.02

# Opcional: histórico no Supabase. A chave service role fica SÓ no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PREDICTION_TABLE=prediction_logs
